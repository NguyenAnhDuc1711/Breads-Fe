# Copy to .env.local and fill in real values. .env.local is gitignored.

# Backend API origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Frontend app origin — used for metadataBase, sitemap, and robots.txt.
# Set to your production domain in production (e.g. https://breads.social).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — comma-separated linkpreview.net API keys (get them at
# https://linkpreview.net). Used by app/api/link-preview/route.ts. Never
# prefix this with NEXT_PUBLIC_ — it must stay out of the browser bundle.
LINKPREVIEW_API_KEYS=

# Server-only — shared secret sent as the `x-sitemap-secret` header on
# requests to the backend's sitemap-eligible endpoints (posts + users, see
# .ccpm/context/handoffs/002.md). Must match SITEMAP_SHARED_SECRET on the
# Breads-Be deployment exactly (AD-3, epic seo-sitemap-schema) — not yet set
# on either side as of Task 010; generate a real random value before
# deploying. Used by app/post-sitemap/sitemap.ts.
SITEMAP_SHARED_SECRET=
