# Copy to .env.local and fill in real values. .env.local is gitignored.

# Backend API origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Frontend app origin — used for metadataBase, sitemap, and robots.txt.
# Set to your production domain in production (e.g. https://breads.social).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — comma-separated linkpreview.net API keys (get them at
# https://linkpreview.net). Used by app/api/link-preview/route.ts. Never
# prefix this with NEXT_PUBLIC_ — it must stay out of the browser bundle.
LINKPREVIEW_API_KEYS=

# Server-only — shared secret sent as the `x-sitemap-secret` header on
# requests to the backend's sitemap-eligible endpoints (posts + users, see
# .ccpm/context/handoffs/002.md). Must match SITEMAP_SHARED_SECRET on the
# Breads-Be deployment exactly (AD-3, epic seo-sitemap-schema) — not yet set
# on either side as of Task 010; generate a real random value before
# deploying. Used by app/post-sitemap/sitemap.ts.
SITEMAP_SHARED_SECRET=

# Google Identity Services OAuth 2.0 Client ID (web application), from
# https://console.cloud.google.com/auth/clients. Not a secret — it ships in the
# browser bundle by design; what protects you is the backend's `aud` check
# (FR-2.3, PRD google-oauth-login), not hiding this value.
#
# Must match GOOGLE_CLIENT_ID on the Breads-Be deployment EXACTLY — the backend
# rejects any ID token whose `aud` is not this value, so a mismatch fails every
# Google sign-in.
#
# The Client ID's "Authorized JavaScript origins" must list every frontend
# origin you serve from: http://localhost:3000, http://localhost:3001 (next dev
# falls back to 3001 when 3000 is taken) and the production domain. No trailing
# slash, no path. "Authorized redirect URIs" stays empty — the ID token flow
# does not use it, and no Client Secret is needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
